# Self-Healing Data Pipeline Environment Configuration

# Paths
DATABASE_PATH=data/pipeline_history.db
REFERENCE_DATA_PATH=data/sample_reference.csv
MODEL_DIR=artifacts/models
QUARANTINE_DIR=data/quarantine
UPLOADS_DIR=data/uploads

# Anomaly Detection Settings
ANOMALY_CONTAMINATION=0.05
RANDOM_SEED=42

# Data Drift Thresholds
DRIFT_PVALUE_THRESHOLD=0.05
DRIFT_CRITICAL_PVALUE=0.01
DRIFT_WASSERSTEIN_THRESHOLD=0.15

# Recovery Engine Settings
AUTO_RECOVERY_MODE=manual
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1.0
RECOVERY_COOLDOWN_SECONDS=60

# Model Validation & Governance Criteria
MODEL_MIN_F1_SCORE=0.65
MODEL_DEGRADATION_TOLERANCE=0.02

# Storage Limits
MAX_UPLOAD_SIZE_MB=25
